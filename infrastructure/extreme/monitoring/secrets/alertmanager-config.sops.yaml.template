# TEMPLATE, placeholders only. Copy to ../alertmanager-config.sops.yaml, fill in, then: sops --encrypt --in-place ../alertmanager-config.sops.yaml
# The whole Alertmanager configuration lives in this one encrypted Secret, so the bot token and your Telegram chat ID
# are never in Git in plain text. The HelmRelease points Alertmanager at this Secret with alertmanagerSpec.configSecret.
# The name is deliberately NOT the chart's own default (alertmanager-kube-prometheus-stack-alertmanager), which the
# chart creates itself: reusing it would make Helm and Flux fight over one object.
# See README.md in this folder. Never commit the filled-in file before encrypting it.
apiVersion: v1
kind: Secret
metadata:
  name: alertmanager-config
  namespace: monitoring
stringData:
  alertmanager.yaml: |
    global:
      resolve_timeout: 5m
    route:
      receiver: telegram
      group_by: [alertname, namespace]
      group_wait: 30s
      group_interval: 5m
      repeat_interval: 12h
      routes:
        # Watchdog always fires (it proves alerting works); stage 4 sends it to a heartbeat service instead.
        - receiver: "null"
          matchers:
            - alertname =~ "Watchdog|InfoInhibitor"
    receivers:
      - name: "null"
      - name: telegram
        telegram_configs:
          - bot_token: BOT_TOKEN
            chat_id: 123456789
            send_resolved: true
    inhibit_rules:
      - source_matchers:
          - severity = critical
        target_matchers:
          - severity =~ "warning|info"
        equal: [namespace, alertname]
      - source_matchers:
          - severity = warning
        target_matchers:
          - severity = info
        equal: [namespace, alertname]
